  "uiWidgets": [
    { "type": "presetWidget", "title": "Presets" },
    { "type": "lightWidget", "title": "Light Control" },
    {
      "type": "textureWidget",
      "title": "Textures",
      "options": {
        "parts": [
          {
            "name": "InsideStrips",
            "label": "Inside Strips (group)",
            "targets": [
              { "type": "mesh", "name": "Insidestrip1" },
              { "type": "mesh", "name": "Insidestrip2" },
              { "type": "mesh", "name": "Insidestrip3" },
              { "type": "mesh", "name": "Insidestrip4" },
              { "type": "mesh", "name": "Insidestrip5" },
              { "type": "mesh", "name": "Insidestrip6" }
