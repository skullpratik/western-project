            "mapping": {
              "offset": { "x": 0, "y": -0.25 },
              "center": { "x": 0.5, "y": -0.05 },
              "flipY": false,
              "repeat": { "x": 1, "y": 1.9 },
              "wrapS": "ClampToEdgeWrapping",
              "wrapT": "ClampToEdgeWrapping"
            }
          },
          {
            "name": "SidepannelRight",
            "mapping": {
              "flipY": false,
              "offset": { "x": 1.5, "y": 0 },
              "center": { "x": 0.5, "y": 0.5 },
              "repeat": { "x": 3.2, "y": 0.9 },
              "wrapS": "ClampToEdgeWrapping",
              "wrapT": "ClampToEdgeWrapping"
            }
          },
          {
            "name": "SidepannelLeft",
            "mapping": {
              "flipY": false,
              "offset": { "x": 1.25, "y": 0 },
              "center": { "x": 0, "y": 0.5 },
              "repeat": { "x": 3.2, "y": 0.9 },
              "wrapS": "ClampToEdgeWrapping",
              "wrapT": "ClampToEdgeWrapping"
            }
          },
          {
            "name": "Cylinder001"
          }
        ],
        "textures": [
          { "name": "canopy", "path": "/texture/pepsicanopy.jpg" },
          { "name": "Glass Clear", "path": "/textures/clear_glass.jpg" }
        ]
        
      }
    },
    {
      "type": "colorPicker",
      "title": "Color Picker",
